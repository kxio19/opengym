# Copy this file to ".env" and adjust for your setup, then: docker compose up -d --build
#
# Local testing works on the Docker host at http://localhost:3012. For a real
# deployment, choose the final HTTPS hostname before creating any passkey.
RP_ID=localhost
ORIGIN=http://localhost:3012
RP_NAME=openGym
WEB_PORT=3012
OPENGYM_DATA_DIR=./data

# Register the owner first, copy users[].id from data/db.json into ADMIN_UIDS,
# then enable invite-only registration and generate codes from the dashboard.
ADMIN_UIDS=
INVITE_ONLY=0
SESSION_DAYS=90

# Private Social is gated twice: here for the instance and by each profile's
# explicit consent. SOCIAL_TZ defines the Monday-Sunday ranking boundary.
SOCIAL_ENABLED=0
SOCIAL_TZ=Europe/Madrid

# Public AGPL source offer and deploy traceability. Change the URL to the fork
# that actually contains the deployed code.
SOURCE_URL=https://github.com/kxio19/opengym
APP_VERSION=dev

# Push keys are generated automatically. Optional public origin or mailto: value:
# VAPID_SUBJECT=https://gym.example.com

# The AI Coach stays inert until configured by an administrator. Uncommenting
# this is an instance-wide kill switch regardless of stored configuration.
# COACH_DISABLED=1
